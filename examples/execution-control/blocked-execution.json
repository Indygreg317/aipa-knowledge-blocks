      "target_environment_is_production"
    ],
    "preconditions": [
      "deployment_request_approved",
      "authority_token_present",
      "audit_logging_available"
    ],
    "priority": "high"
  },
  "logic": [
    "A production configuration update may proceed only when the system state is stable.",
    "Execution must be blocked if an active incident creates a deployment restriction.",
    "Runtime risk posture must remain within the configured threshold.",
    "Authority must remain valid at execution time, but authority alone is not sufficient if policy or risk checks fail."
  ],
  "evidence": [
    "deployment_request_approved",
    "production_state_stable_at_approval_time",
    "devops_authority_valid_at_approval_time"
  ],
  "execution_control": {
    "requires_revalidation": true,
    "required_authority": [
      "devops-engineer"
    ],
    "authority_mode": "strict",
    "delta_threshold": 0.2,
    "delta_mode": "strict",
    "evidence_freshness_window": "PT6H",
    "block_on_policy_mismatch": true,
    "fail_behavior": "block",
    "allowed_actions": [
      "deploy_configuration_update"
    ],
    "prohibited_actions": [
      "deploy_during_active_incident",
      "deploy_without_audit_log",
      "deploy_without_valid_authority"
    ],
    "audit_log_required": true
  },
  "revalidation": {
    "compare_context": true,
    "compare_policy": true,
    "compare_inputs": true,
    "compare_risk_posture": true,
    "compare_evidence": true,
    "on_mismatch": "block"
  },
  "risk_posture": {
    "impact": "high",
    "likelihood": 0.7,
    "uncertainty": 0.3,
    "system_state": "production",
    "exposure_window": "persistent",
    "max_allowed_score": 0.5
  },
  "decision_time_state": {
