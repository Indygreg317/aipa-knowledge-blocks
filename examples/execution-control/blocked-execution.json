{
  "index": {
    "knowledge_block_id": "AIPA-KB-DEPLOY-BLOCK-001",
    "title": "Blocked Configuration Deployment",
    "description": "Example Knowledge Block showing a deployment action blocked after runtime revalidation fails.",
